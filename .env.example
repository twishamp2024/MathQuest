# MathQuest Environment Configuration Example
# Copy this file to .env for local overrides

# Application Environment
MATHQUEST_ENV=development
MATHQUEST_DEBUG=true
MATHQUEST_PORT=8000
MATHQUEST_HOST=0.0.0.0

# Database Configuration
# Local SQLite database file path
MATHQUEST_DATABASE_URL=sqlite:///./mathquest.db

# Optional AI Question Generation Provider
# Supported: gemini, mock, offline
MATHQUEST_AI_PROVIDER=offline
# If using Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MATHQUEST_AI_TIMEOUT_SECONDS=5.0
MATHQUEST_AI_MAX_RETRIES=2

# Security & Limits
MATHQUEST_RATE_LIMIT_PER_MINUTE=120
MATHQUEST_CORS_ORIGINS=["*"]

# Firmware & Content Update Service
MATHQUEST_FIRMWARE_CHANNEL=stable
MATHQUEST_FIRMWARE_VERSION=1.0.0
MATHQUEST_CONTENT_VERSION=2026.10.1
